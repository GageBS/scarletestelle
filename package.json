{
  "name": "scarletestelle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/studio.db',{force:true})\" && npm run db:push && npm run db:seed",
    "automations:run": "tsx --env-file=.env.local scripts/run-automations.ts",
    "hash-password": "node -e \"console.log(require('bcryptjs').hashSync(process.argv[1],12))\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
