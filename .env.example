# ── Scarlet Estelle — local settings (never commit this file) ──
SITE_URL=http://localhost:3000
DATABASE_URL=file:./data/studio.db
# DATABASE_AUTH_TOKEN=          # only for a hosted Turso database

# Studio login (/studio). Change the password any time.
STUDIO_PASSWORD=change-me
# or, more secure: STUDIO_PASSWORD_HASH=<bcrypt hash>  (npm run hash-password)
SESSION_SECRET=change-me

# Uploaded photos live here
STORAGE_DIR=./storage

# ── Email (optional). Without these, emails are SAVED in the studio Outbox but NOT delivered.
# RESEND_API_KEY=
# EMAIL_FROM="Scarlet Estelle <hello@yourdomain.com>"

# ── Card payments (optional). Without these, clients see Venmo/Zelle instructions instead.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Protects the automations cron endpoint
CRON_SECRET=change-me
